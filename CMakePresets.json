{
  "version": 3,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja Multi-Config"
    },
    {
      "name": "clang",
      "inherits": ["base"],
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang++"
      },
      "binaryDir": "${sourceDir}/out/build/${presetName}"
    }
  ],
  "buildPresets": [
    {
      "name": "clang-debug",
      "configurePreset": "clang",
      "configuration": "Debug"
    }
  ]
}
