{
     "clangd.arguments": [
          "--background-index",
          "--background-index-priority=normal",
          "-j=8",
          "--pch-storage=memory",
          "--experimental-modules-support",
          "--clang-tidy",
          "--completion-style=detailed",
          "--header-insertion=iwyu",
          "--function-arg-placeholders=true",
          "--all-scopes-completion",
          "--limit-results=0",
          "--limit-references=0"
     ],
     "cmake.buildBeforeRun": true
}
